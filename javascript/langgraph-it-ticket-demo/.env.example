# mock = scripted decisions, no API key needed; live = call a real LLM (needs a key below)
# Override for one run with --mock or --live
DEMO_MODE=mock

# Which provider live mode uses: openrouter, groq, or openai (can be overridden with --provider)
LLM_PROVIDER=openrouter

# Fill in only the provider you use
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=choose-a-tool-capable-model

GROQ_API_KEY=replace-with-your-key
GROQ_MODEL=choose-a-tool-capable-model

OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=choose-a-tool-capable-model
